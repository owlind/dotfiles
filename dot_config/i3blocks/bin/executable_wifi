#!/usr/bin/env bash

set -uo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/colors.sh"

ip route get 1.1.1.1 > /dev/null 2>/dev/null
if ! [[ $? -eq 0 ]] ; then
    echo "down"
    echo "down"
    echo "$subtle"
    exit 0
fi

iface=$(ip -j route get 1.1.1.1 | jq -r '.[0].dev')

if ! [[ -d "/sys/class/net/$iface" ]] ; then
    # This shouldn't happen
    exit 1
fi

if [[ $(cat "/sys/class/net/$iface/operstate") = 'down' ]] ; then
    echo "down"
    echo "down"
    echo "$rose"
    exit 0
fi

if [[ -d "/sys/class/net/$iface/wireless" ]] ; then
    info=$(iwctl station wlan0 show | sed -E 's/[[:space:]]+$//; s/ {2,}/\t/g')
    ssid=$(awk -F'\t' '/Connected network/{print $NF}' <<< "$info")
    rssi=$(awk -F'\t' '/RSSI/{print $NF}' <<< "$info" | awk '{print $1}' | head -n 1)
    qual=$(awk -v r="$rssi" 'BEGIN{ print (r > -50 ? 100 : (r < -100 ? 0 : (r+100)*2)) }')
    wireless=" ($ssid $qual%)"
else
    wireless=""
fi

echo "up [$iface$wireless]"
echo "up [$iface$wireless]"
echo "$subtle"
exit 0
