#!/usr/bin/env bash

source colors.sh

ip route get 1.1.1.1 > /dev/null
if ! [ $? -eq 0 ] ; then
    echo "down"
    echo "down"
    echo $subtle
    exit
fi

iface=$(ip -j route get 1.1.1.1 | jq -r '.[0].dev')

if ! [ -d /sys/class/net/$iface ] ; then
    # This shouldn't happen
    exit 1
fi

if [ $(cat /sys/class/net/$iface/operstate) = 'down' ] ; then
    echo "down"
    echo "down"
    echo $rose
    exit 0
fi

if [ -d /sys/class/net/$iface/wireless ] ; then
    ssid=$(iwctl station $iface show | grep 'Connected network' | awk '{ print $3 }')
    qual=$(iwctl station $iface show | grep 'RSSI' | head -n 1 | awk '{print ($2 > -50 ? 100 :($2 < -100 ? 0 : ($2+100)*2))}')
    wireless=" ($ssid $qual%)"
else
    wireless=""
fi

echo "up [$iface$wireless]"
echo "up [$iface$wireless]"
echo $subtle
exit 0
