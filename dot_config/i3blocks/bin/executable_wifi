#!/usr/bin/env bash

source colors.sh

# TODO: Make $iface configurable

# Check if we're connected
ip route get 1.1.1.1 > /dev/null
if ! [ $? -eq 0 ] ; then
    echo "disconnected"
    echo "disconnected"
    echo $subtle
    exit
fi

# Connected, check the default interfaec
iface=$(ip route show default | cut -d' ' -f5)

if ! [ -d /sys/class/net/$iface ] ; then
    # This shouldn't happen
    exit 1
fi

if [ $(cat /sys/class/net/$iface/operstate) = 'down' ] ; then
    echo "down"
    echo "down"
    echo $rose
    exit 0
fi

if [ -d /sys/class/net/$iface/wireless ] ; then
    ssid=$(iw dev $iface link | grep SSID | cut -d' ' -f2)
    qual=$(iw dev wlan0 link | grep 'dBm$' | cut -d' ' -f2 | awk '{print ($1 > -50 ? 100 :($1 < -100 ? 0 : ($1+100)*2))}')
    wireless=" ($ssid $qual%)"
else
    wireless=""
fi

echo "up@$iface$wireless"
echo "up@$iface$wireless"
echo $subtle
exit 0
